\name{ocrsphi_validation}
\alias{ocrsphi_validation}
\title{Load the bundled openCOSMO-RS-Phi global validation dataset}
\usage{ocrsphi_validation()}
\value{A list containing point predictions, route summaries, references, candidate fits, coverage, and metadata.}
\description{Loads route-aware openCOSMO-RS-Phi solubility validation data. The evaluation role distinguishes external Psat-route validation, raw-solubility holdout data, and raw-solubility training data.}
